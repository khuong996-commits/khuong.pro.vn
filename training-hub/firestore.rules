rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isVerifiedGoogleUser() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email_verified == true
        && request.auth.token.firebase.sign_in_provider == 'google.com';
    }

    function currentEmail() {
      return request.auth.token.email.lower();
    }

    function membership() {
      return get(/databases/$(database)/documents/web_memberships/$(request.auth.uid)).data;
    }

    function isActiveTrainingMember() {
      return isVerifiedGoogleUser()
        && membership().enabled == true
        && membership().apps.training == true
        && membership().role in ['admin', 'leader', 'member'];
    }

    function isAdmin() {
      return isActiveTrainingMember() && membership().role == 'admin';
    }

    function isLeader() {
      return isActiveTrainingMember() && membership().role == 'leader';
    }

    function isValidEmail(email) {
      return email.matches('^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}$');
    }

    function profileFields() {
      return ['displayName', 'email', 'birthday', 'phone', 'joinDate', 'facebookUrl', 'zaloPhone', 'bio',
        'completedModules', 'createdAt', 'updatedAt', 'accessHistory', 'lastLogin', 'deviceInfo', 'photoURL'];
    }

    function isValidSelfServiceMembership(uid) {
      return isVerifiedGoogleUser()
        && request.auth.uid == uid
        && exists(/databases/$(database)/documents/whitelist/$(currentEmail()))
        && request.resource.data.keys().hasAll(['email', 'enabled', 'role', 'apps'])
        && request.resource.data.keys().hasOnly(['email', 'enabled', 'role', 'apps'])
        && request.resource.data.email == currentEmail()
        && request.resource.data.enabled == true
        && request.resource.data.role == get(/databases/$(database)/documents/whitelist/$(currentEmail())).data.role
        && request.resource.data.role in ['member', 'leader']
        && request.resource.data.apps.keys().hasAll(['training'])
        && request.resource.data.apps.keys().hasOnly(['training'])
        && request.resource.data.apps.training == true;
    }

    function leaderCreatesOwnMember(email) {
      return isLeader()
        && email != currentEmail()
        && isValidEmail(email)
        && request.resource.data.role == 'member'
        && request.resource.data.leaderEmail == currentEmail()
        && request.resource.data.addedBy == currentEmail();
    }

    function leaderUpdatesOwnMember(email) {
      return isLeader()
        && email != currentEmail()
        && resource.data.role == 'member'
        && resource.data.leaderEmail == currentEmail()
        && request.resource.data.role == 'member'
        && request.resource.data.leaderEmail == currentEmail()
        && request.resource.data.addedBy == resource.data.addedBy;
    }

    function leaderDeletesOwnMember(email) {
      return isLeader()
        && email != currentEmail()
        && resource.data.role == 'member'
        && resource.data.leaderEmail == currentEmail();
    }

    match /web_memberships/{uid} {
      allow get: if isVerifiedGoogleUser() && request.auth.uid == uid;
      allow create: if isValidSelfServiceMembership(uid);
      allow list, update, delete: if false;
    }

    match /whitelist/{email} {
      allow get: if isActiveTrainingMember()
        || (isVerifiedGoogleUser() && currentEmail() == email);
      allow list: if isActiveTrainingMember();
      allow create: if isAdmin() || leaderCreatesOwnMember(email);
      allow update: if isAdmin() || leaderUpdatesOwnMember(email);
      allow delete: if isAdmin() || leaderDeletesOwnMember(email);
    }

    match /profiles/{email} {
      allow get: if isActiveTrainingMember() && (currentEmail() == email || isAdmin());
      allow list: if isAdmin();
      allow create: if isAdmin() || (isActiveTrainingMember() && currentEmail() == email
        && request.resource.data.keys().hasOnly(profileFields())
        && request.resource.data.email == email
        && request.resource.data.completedModules == []);
      allow update: if isAdmin() || (isActiveTrainingMember() && currentEmail() == email
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName', 'birthday', 'phone', 'joinDate', 'facebookUrl', 'zaloPhone', 'bio',
          'updatedAt', 'accessHistory', 'lastLogin', 'deviceInfo', 'photoURL', 'completedModules'])
        && request.resource.data.completedModules is list
        && request.resource.data.completedModules.size() <= 500
        && request.resource.data.bio is string
        && request.resource.data.bio.size() <= 5000);
      allow delete: if isAdmin();
    }

    match /team_schedule/{event} {
      allow read: if isActiveTrainingMember();
      allow create: if isActiveTrainingMember()
        && request.resource.data.ownerUid is string
        && (isAdmin() || (request.resource.data.ownerUid == request.auth.uid
          && request.resource.data.ownerEmail == currentEmail()))
        && request.resource.data.createdBy == request.auth.token.email
        && request.resource.data.keys().hasOnly(scheduleFields())
        && validSchedule();
      allow update: if isActiveTrainingMember() && (isAdmin() || resource.data.ownerUid == request.auth.uid)
        && (('ownerUid' in resource.data && request.resource.data.ownerUid == resource.data.ownerUid)
          || (!('ownerUid' in resource.data) && isAdmin() && request.resource.data.ownerUid is string))
        && request.resource.data.ownerEmail == resource.data.ownerEmail
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.keys().hasOnly(scheduleFields())
        && validSchedule();
      allow delete: if isActiveTrainingMember() && (isAdmin() || resource.data.ownerUid == request.auth.uid);
    }

    function validSchedule() {
      return request.resource.data.date is string && request.resource.data.date.size() == 10
        && request.resource.data.customerName is string && request.resource.data.customerName.size() <= 300
        && request.resource.data.notes is string && request.resource.data.notes.size() <= 10000
        && request.resource.data.participantEmails is list && request.resource.data.participantEmails.size() <= 100
        && request.resource.data.supportEmails is list && request.resource.data.supportEmails.size() <= 100;
    }

    function scheduleFields() {
      return ['ownerUid', 'ownerEmail', 'ownerName', 'customerName', 'date', 'startTime', 'type', 'status',
        'participantEmails', 'participantNames', 'participantExtra', 'participantExtraNames', 'participantLabels',
        'supportEmails', 'supportNames', 'supportExtra', 'supportExtraNames', 'supportLabels', 'notes', 'updatedBy',
        'updatedAt', 'createdBy', 'createdAt', 'sourceConsultingId', 'sourceConsultingDate', 'sourceConsultingTime',
        'sourceConsultingCustomer', 'latestFieldTripId', 'latestFieldTripDate', 'latestFieldTripTime'];
    }

    match /web_finance/{account} {
      allow read: if isActiveTrainingMember()
        && membership().apps.finance == true
        && membership().financeAccount == account;
      allow create, update: if isActiveTrainingMember()
        && membership().apps.finance == true
        && membership().financeAccount == account
        && request.resource.data.keys().hasOnly(['payload'])
        && request.resource.data.payload is string
        && request.resource.data.payload.size() <= 550000;
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
