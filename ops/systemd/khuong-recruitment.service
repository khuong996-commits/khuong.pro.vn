[Unit]
Description=TL Land recruitment form receiver
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/khuong-recruitment
EnvironmentFile=/etc/khuong-recruitment/recruitment.env
ExecStart=/usr/bin/python3 /opt/khuong-recruitment/recruitment_receiver.py
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
ProtectControlGroups=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadOnlyPaths=/opt/khuong-recruitment
UMask=0077

[Install]
WantedBy=multi-user.target
