rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email_verified == true
        && request.auth.token.firebase.sign_in_provider == 'google.com';
    }

    function isCoreAdmin() {
      return isSignedIn()
        && request.auth.token.email in ['ih.khuongtrinh@gmail.com', 'thangckvt@gmail.com'];
    }

    function isTeamMember() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/whitelist/$(request.auth.token.email));
    }

    function isLeader() {
      return isTeamMember()
        && get(/databases/$(database)/documents/whitelist/$(request.auth.token.email)).data.role == 'leader';
    }

    function canManageTeamData() {
      return isCoreAdmin() || isLeader();
    }

    function ownsEmail(email) {
      return isTeamMember() && request.auth.token.email == email;
    }

    function isValidEmail(email) {
      return email.matches('^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}$');
    }

    match /whitelist/{email} {
      // The UI needs the staff directory for scheduling. It is now limited to
      // a verified Google account that is already present in the team.
      allow read: if isTeamMember();

      allow write: if isCoreAdmin();

      // Leaders may manage ordinary members but may not create a leader/admin.
      allow create, update: if isValidEmail(email) && isLeader()
        && request.resource.data.role == 'member';
      allow delete: if isValidEmail(email) && isLeader()
        && resource.data.role == 'member';
    }

    match /profiles/{email} {
      // A staff member can only access their own profile. Leaders and core
      // admins retain the existing team-management view.
      allow get: if ownsEmail(email) || canManageTeamData();
      allow list: if canManageTeamData();
      allow create: if ownsEmail(email);
      allow update: if ownsEmail(email) || canManageTeamData();
      allow delete: if isCoreAdmin();
    }

    match /checklist_daily/{docId} {
      allow read: if isTeamMember();
      allow create: if ownsEmail(request.resource.data.email);
      allow update: if canManageTeamData()
        || (ownsEmail(resource.data.email)
          && request.resource.data.email == request.auth.token.email);
      allow delete: if canManageTeamData();
    }

    match /team_schedule/{docId} {
      allow read: if isTeamMember();
      allow create, update, delete: if canManageTeamData();
      allow create: if ownsEmail(request.resource.data.ownerEmail);
      allow update: if ownsEmail(resource.data.ownerEmail)
        && request.resource.data.ownerEmail == request.auth.token.email;
      allow delete: if ownsEmail(resource.data.ownerEmail);
    }

    match /clients/{docId} {
      // CRM records may only be queried or changed by their owner, except for
      // the two designated core admins. The client query already filters on
      // ownerEmail for non-admin users.
      allow get, list: if isCoreAdmin()
        || (isTeamMember() && resource.data.ownerEmail == request.auth.token.email);
      allow create: if ownsEmail(request.resource.data.ownerEmail);
      allow update: if isCoreAdmin()
        || (ownsEmail(resource.data.ownerEmail)
          && request.resource.data.ownerEmail == request.auth.token.email);
      allow delete: if isCoreAdmin()
        || ownsEmail(resource.data.ownerEmail);
    }
  }
}
